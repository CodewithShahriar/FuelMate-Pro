{
  "name": "FuelMate Pro",
  "short_name": "FuelMate",
  "description": "Smart motorcycle fuel economy, service cost & maintenance companion",
  "id": "/app/dashboard",
  "start_url": "/app/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#06070a",
  "theme_color": "#06070a",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "categories": ["utilities", "lifestyle", "productivity"],
  "shortcuts": [
    {
      "name": "Add Fuel",
      "short_name": "Fuel",
      "url": "/app/fuel",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Trip Calculator",
      "short_name": "Calculator",
      "url": "/app/calculator",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Service & Costs",
      "short_name": "Costs",
      "url": "/app/expenses",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
